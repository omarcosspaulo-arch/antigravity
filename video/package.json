{
  "name": "curta-viral",
  "version": "1.0.0",
  "private": true,
  "description": "Curtas animados verticais (60s) no formato 'fato estranho + reviravolta', feitos com Remotion + three.js",
  "type": "module",
  "scripts": {
    "voz": "node scripts/voz.mjs",
    "sons": "node scripts/sons.mjs",
    "preparar": "npm run voz && npm run sons",
    "studio": "remotion studio",
    "render": "remotion render CurtaViral out/curta.mp4",
    "render:rapido": "remotion render CurtaViral out/curta-preview.mp4 --scale=0.5",
    "still": "remotion still CurtaViral out/frame.png",
    "typecheck": "tsc --noEmit",
    "previa": "node scripts/previa.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/bundler": "4.0.537",
    "@remotion/cli": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "@remotion/three": "4.0.537",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "remotion": "4.0.537",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/three": "0.186.0",
    "typescript": "5.9.3"
  }
}
